# MongoDB
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=replace_with_secure_root_password
MONGO_DB=sensor_db
MONGO_PORT=27017

# Application database user
APP_DB_USER=sensor_app
APP_DB_PASSWORD=replace_with_secure_app_password

# Ingestion
BATCH_SIZE=500

# FastAPI
API_PORT=8000

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace_with_secure_grafana_password
GRAFANA_PORT=3000
